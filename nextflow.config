/*
 * nextflow.config — Global runtime configuration
 * Layer: Infrastructure Layer
 */

// ── Default parameters ────────────────────────────────────────────────────────
params {
    input             = null
    outdir            = 'results'

    // Short read QC
    min_quality       = 20
    min_length        = 50
    adapter_fasta     = null

    // Long read QC
    min_quality_long  = 10
    min_length_long   = 1000
    run_basecalling   = false
    dorado_model      = 'dna_r10.4.1_e8.2_400bps_hac@v4.3.0'
    run_porechop      = true
    run_filtlong      = true

    // Host removal
    host_genome       = '/home/koraop/nob_dir/metagenomics/metagenomics_pipe/databases/GRCh38/host/GRCh38_noalt.fa'
    host_index_prefix = 'host'

    // Assembly & Polishing
    assembler         = 'megahit'
    flye_mode         = '--nano-raw'
    flye_extra_args   = ''
    run_polishing     = true
    polisher          = 'racon'

    // MAG Reconstruction & Binning
    min_contig_len_binning = 1500
    run_metabat2           = true
    run_maxbin2            = false
    run_semibin2           = false
    semibin_environment    = 'global'
    run_concoct            = false
    run_dastool            = false
    dastool_threshold      = 0.5

    // MAG QC & Taxonomy Databases
    run_checkm2            = false
    checkm2_db             = null
    run_gunc               = false
    gunc_db                = null
    run_gtdbtk             = false
    gtdbtk_db              = '/home/koraop/nob_dir/metagenomics/metagenomics_pipe/databases/databases/gtdbtk'

    // Read-Based Analysis (Kraken2, Bracken, Krona, HUMAnN3)
    run_kraken2            = true
    kraken2_db             = '/home/koraop/nob_dir/metagenomics/metagenomics_pipe/databases/Standard/kraken2'
    run_bracken            = true
    bracken_read_len       = 150
    bracken_level          = 'S'
    bracken_threshold      = 10
    run_krona              = true
    run_kraken_biom        = true
    run_humann3            = false
    humann3_nucleotide_db  = null
    humann3_protein_db     = null

    // Annotation & Reporting (Prokka, geNomad, MultiQC, Reports)
    run_prokka             = true
    run_genomad            = false
    genomad_db             = null
    run_multiqc            = true
    run_custom_report      = true
    template_html          = null
    template_md            = null

    // Resource limits
    max_cpus          = 4
    max_memory        = '8.GB'
    max_time          = '2.h'
}

// ── Profiles ──────────────────────────────────────────────────────────────────
profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
    conda {
        conda.enabled          = true
        conda.useMamba         = false
        docker.enabled         = false
        singularity.enabled    = false

        // Resolve the pixi envs root portably:
        //   1. PIXI_PROJECT_ROOT  — set automatically by `pixi run` / `pixi shell`
        //   2. projectDir         — fallback when nextflow is called directly
        def _pixi = System.getenv('PIXI_PROJECT_ROOT') ?: projectDir.toString()

        process.conda = "${_pixi}/.pixi/envs/default"

        process {
            withName: 'CHECKM2' {
                conda = "${_pixi}/.pixi/envs/checkm2"
            }
            withName: 'PROKKA' {
                conda = "${_pixi}/.pixi/envs/prokka"
            }
            withName: 'SEMIBIN2' {
                conda = "${_pixi}/.pixi/envs/semibin"
            }
            withName: 'GUNC' {
                conda = "${_pixi}/.pixi/envs/gunc"
            }
            withName: 'GTDBTK' {
                conda = "${_pixi}/.pixi/envs/gtdbtk"
            }
            withName: 'HUMANN3' {
                conda = "${_pixi}/.pixi/envs/humann"
            }
        }
    }
    local {
        docker.enabled         = false
        singularity.enabled    = false
    }
}

// ── Process defaults ──────────────────────────────────────────────────────────
process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-2]?.toLowerCase() ?: 'misc'}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        enabled: true
    ]
    cpus   = { Math.min( 2 * task.attempt, params.max_cpus as int ) }
    memory = { 4.GB * task.attempt }
    time   = { 1.h * task.attempt }

    errorStrategy = { task.exitStatus in [140,143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_medium {
        cpus   = { Math.min( 4 * task.attempt, params.max_cpus as int ) }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: process_high {
        cpus   = { Math.min( 8 * task.attempt, params.max_cpus as int ) }
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: process_high_gpu {
        cpus   = { Math.min( 8 * task.attempt, params.max_cpus as int ) }
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
}

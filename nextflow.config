params {
    // 1. Core Pipeline Inputs & Outputs
    input           = null           // samplesheet CSV, required
    outdir          = 'results'
    normalise       = false          // gate the optional BBNorm step

    // 2. Host Removal (QC arms)
    host_bt2_index  = null
    host_fasta      = null

    // 3. Long-read processing (Dorado tool)
    dorado_model    = null           

    // 4. Assembly-Free Profiling (ตรงตาม 7 arguments ล่าสุดของคุณ)
    kraken2_db      = null
    bracken_db      = null
    metaphlan_db    = null
    humann_nuc_db   = null
    humann_prot_db  = null

    // 5. Bin QC Databases
    gunc_db         = null
    checkm2_db      = null
    busco_lineage   = null

    // 6. Bin Taxonomy & Annotation (ตรงตาม 5 arguments ล่าสุดของคุณ)
    gtdbtk_db       = null           // ส่งเข้า ch_tax_db
    cat_taxonomy    = null           // ส่งเข้า ch_cat_taxonomy
    mmseqs_db       = null           // ส่งเข้า ch_mmseqs_db
    eggnog_db       = null           // ส่งเข้า ch_eggnog_db
}

profiles {
    docker      { docker.enabled = true }
    singularity { singularity.enabled = true; singularity.autoMounts = true }
    conda       { conda.enabled = true }
    test        { includeConfig 'conf/test.config' }
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

manifest {
    name            = 'hybrid-metagenomics-pipeline'
    description     = 'Hybrid short/long-read metagenomics: assembly-free + assembly-based'
    nextflowVersion = '>=23.10.0'
}

report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace.txt" }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline.html" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag.svg" }
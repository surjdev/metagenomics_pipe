/*
 * conf/nanoplot_clean.config — Configuration for NanoPlot QC on Clean Long Reads
 * Layer: Infrastructure Layer
 */

params {
    // ── Input & Output ────────────────────────────────────────────────────────
    input                  = "${launchDir}/samplesheet_hybrid_clean.csv"
    outdir                 = "${launchDir}/results_hybrid/preprocessing/nanoplot_clean"

    // ── Resource Limits ───────────────────────────────────────────────────────
    max_cpus               = 8
    max_memory             = '32.GB'
    max_time               = '2.h'
}

// ── Output Publishing Layout ──────────────────────────────────────────────────
process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        enabled: true
    ]
}

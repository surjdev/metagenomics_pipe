/*
 * conf/test.config — CI/test profile
 * Uses tiny synthetic FASTQ files in test/data/
 */
params {
    // ── Test inputs ───────────────────────────────────────────────────────────
    input             = "${projectDir}/test/data/samplesheet.csv"

    // ── Short read QC (relaxed for tiny test reads) ───────────────────────────
    min_quality       = 10
    min_length        = 20

    // ── Long read QC ──────────────────────────────────────────────────────────
    min_quality_long  = 5
    min_length_long   = 100
    run_basecalling   = false
    run_porechop      = true
    run_filtlong      = true

    // ── Host removal ──────────────────────────────────────────────────────────
    host_genome       = "${projectDir}/test/data/tiny_databases/host_ref.fasta"
    host_index_prefix = 'host'

    // ── Resources (tiny — runs in minutes) ────────────────────────────────────
    max_cpus          = 2
    max_memory        = '4.GB'
    max_time          = '30.m'
}

/*
 * conf/test.config — CI/test profile
 * Uses tiny synthetic FASTQ files in test/data/
 */
params {
    // ── Test inputs ───────────────────────────────────────────────────────────
    input             = "${launchDir}/test/data/samplesheet.csv"

    // ── Short read QC (relaxed for tiny test reads) ───────────────────────────
    min_quality       = 10
    min_length        = 20

    // ── Long read QC ──────────────────────────────────────────────────────────
    min_quality_long  = 5
    min_length_long   = 100
    run_basecalling   = false
    run_porechop      = true
    run_filtlong      = true

    // ── Host removal ──────────────────────────────────────────────────────────
    host_genome       = "${launchDir}/test/data/tiny_databases/host_ref.fasta"
    host_index_prefix = 'host'

    // ── Assembly & Polishing ──────────────────────────────────────────────────
    assembler         = 'megahit'
    run_polishing     = false
    polisher          = 'racon'
    run_quast         = true
    flye_mode         = '--nano-hq'
    flye_extra_args   = '--min-overlap 1000'

    // ── Binning & MAG Reconstruction ──────────────────────────────────────────
    min_contig_len_binning = 500
    run_metabat2           = true
    run_maxbin2            = false
    run_semibin2           = false
    semibin_environment    = 'global'
    run_concoct            = false
    run_dastool            = false
    dastool_threshold      = 0.1
    run_checkm2            = false
    run_gunc               = false
    run_gtdbtk             = false

    // ── Read-Based Analysis ───────────────────────────────────────────────────
    run_kraken2            = true
    kraken2_db             = "${launchDir}/test/data/tiny_databases/kraken2_db"
    run_bracken            = false
    bracken_read_len       = 150
    bracken_level          = 'S'
    bracken_threshold      = 10
    run_krona              = true
    run_kraken_biom        = true
    run_humann3            = false
    humann3_nucleotide_db  = null
    humann3_protein_db     = null

    // ── Annotation & Reporting ────────────────────────────────────────────────
    run_prokka             = true
    run_genomad            = false
    genomad_db             = null
    run_multiqc            = true
    run_custom_report      = true
    template_html          = "${launchDir}/templates/report.html"
    template_md            = "${launchDir}/templates/summary.md"

    // ── Resources (tiny — runs in minutes) ────────────────────────────────────
    max_cpus          = 2
    max_memory        = '4.GB'
    max_time          = '30.m'
}

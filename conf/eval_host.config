/*
 * conf/eval_host.config — Dedicated Configuration for Host Removal & Krona Evaluation
 * Layer: Infrastructure Layer
 *
 * Configured according to Oxford Nanopore EPI2ME (wf-metagenomics) standards:
 * - Filtlong Q10+, length >= 300 bp
 * - Minimap2 ONT host mapping (-ax map-ont)
 * - Kraken2 + Krona dual-branch comparison (With Host vs Clean Non-Host)
 */

params {
    // ── Input & Output ────────────────────────────────────────────────────────
    input                  = "${launchDir}/samplesheet_meta_npi_full.csv"
    outdir                 = "${launchDir}/results_eval_host"

    // ── Preprocessing (Oxford Nanopore EPI2ME standard) ───────────────────────
    min_quality_long       = 10
    min_length_long        = 300
    run_filtlong           = true

    // ── Host Removal (Broiler Chicken Reference) ──────────────────────────────
    host_genome            = "/home/koraop/nob_dir/metagenomics/metagenomics_pipe/databases/GRCg7b_GCF/GCF_016699485.2_bGalGal1.mat.broiler.GRCg7b_genomic.fna"

    // ── Taxonomic Profiling (Kraken2 & Krona) ─────────────────────────────────
    kraken2_db             = "/home/koraop/nob_dir/metagenomics/metagenomics_pipe/databases/Standard/kraken2"
    kraken2_confidence     = 0.0    // Optional confidence threshold (0.0 to 0.1)
    run_krona              = true

    // ── Resource Limits ───────────────────────────────────────────────────────
    max_cpus               = 4
    max_memory             = '32.GB'
    max_time               = '4.h'
}

// ── Output Publishing Layout ──────────────────────────────────────────────────
process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        enabled: true
    ]
}

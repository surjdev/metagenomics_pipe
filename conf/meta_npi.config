/*
 * conf/meta_npi.config — Nanopore Dorado (Meta_NPI) Test Profile
 * Tailored for ONT R10.4.1 Dorado SUP basecalled reads.
 */

params {
    // ── Input & Execution Mode ───────────────────────────────────────────────
    input                  = "${launchDir}/samplesheet_meta_npi_smoke.csv"
    outdir                 = 'results_meta_npi'
    mode                   = 'assembly_free'
    platform               = 'long'

    // ── Long Read Preprocessing ───────────────────────────────────────────────
    min_quality_long       = 10
    min_length_long        = 300
    run_basecalling        = false
    run_porechop           = false
    run_filtlong           = true

    // ── Host Removal ──────────────────────────────────────────────────────────
    run_host_removal       = false
    host_genome            = null
    host_index_prefix      = 'host'

    // ── Assembly & Polishing ──────────────────────────────────────────────────
    run_assembly           = true
    assembler              = 'flye'
    flye_mode              = '--nano-hq'
    flye_extra_args        = '--meta --min-overlap 1000'
    run_polishing          = false
    run_quast              = true

    // ── Binning & MAG Reconstruction ──────────────────────────────────────────
    min_contig_len_binning = 500
    run_metabat2           = true
    run_maxbin2            = false
    run_semibin2           = false
    semibin_environment    = 'global'
    run_concoct            = false
    run_dastool            = false
    run_checkm2            = false
    run_gunc               = false
    run_gtdbtk             = false

    // ── Read-Based Taxonomic & Functional Profiling ───────────────────────────
    run_kraken2            = true
    kraken2_db             = "${launchDir}/test/data/tiny_databases/kraken2_db"
    run_bracken            = false
    run_krona              = true
    run_kraken_biom        = true
    run_humann3            = false

    // ── Functional Annotation & Reporting ─────────────────────────────────────
    run_prokka             = true
    run_genomad            = false
    run_multiqc            = true
    run_custom_report      = true
    template_html          = "${launchDir}/templates/report.html"
    template_md            = "${launchDir}/templates/summary.md"

    // ── Resource Limits ───────────────────────────────────────────────────────
    max_cpus               = 4
    max_memory             = '32.GB'
    max_time               = '4.h'
}

/*
 * conf/compare_assembly_free.config — Configuration for Short vs Long Metagenomics Comparison Pipeline
 * Layer: Infrastructure Layer
 *
 * Dedicated to benchmarking Short Reads (Illumina) vs Long Reads (Oxford Nanopore)
 * under Assembly-Free Taxonomic & Abundance Profiling.
 */

params {
    // ── Input & Output ────────────────────────────────────────────────────────
    input                  = "${launchDir}/samplesheet_hybrid.csv"
    outdir                 = "${launchDir}/results_compare_assembly_free"

    // ── Execution Toggles ─────────────────────────────────────────────────────
    run_preprocessing      = true    // Fastp (short) & Filtlong (long)
    run_host_removal       = true    // Bowtie2 (short) & Minimap2 (long)
    run_kraken2            = true
    run_bracken            = false   // Optional Bracken for short reads
    run_krona              = true    // Interactive Krona charts
    run_kraken_biom        = true    // Export BIOM 1.0 JSON & TSV matrices
    run_multiqc            = true    // Consolidated MultiQC report

    // ── Preprocessing Filters ─────────────────────────────────────────────────
    min_quality            = 20      // Short reads min Q-score (Fastp)
    min_length             = 50      // Short reads min length
    min_quality_long       = 10      // Long reads min Q-score (Filtlong)
    min_length_long        = 300     // Long reads min length

    // ── Host Removal Databases ────────────────────────────────────────────────
    host_genome            = "/home/koraop/nob_dir/metagenomics/metagenomics_pipe/databases/GRCg7b_GCF/GCF_016699485.2_bGalGal1.mat.broiler.GRCg7b_genomic.fna"

    // ── Taxonomic Profiling Databases ─────────────────────────────────────────
    kraken2_db             = "/home/koraop/nob_dir/metagenomics/metagenomics_pipe/databases/Standard/kraken2"
    kraken2_confidence     = 0.0
    bracken_read_len       = 150
    bracken_level          = 'S'
    bracken_threshold      = 10
    save_kraken_output     = false   // Avoid saving per-read gigabyte text files

    // ── Resource Limits (Tuned for compute nodes & SLURM) ──────────────────────
    max_cpus               = 4
    max_memory             = '32.GB'
    max_time               = '4.h'
}

// ── Output Publishing Layout ──────────────────────────────────────────────────
process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        enabled: true
    ]
}

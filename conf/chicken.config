/*
 * conf/chicken.config — Configuration for Chicken Nanopore (Assembly-Free)
 */

params {
    // ── Input & Output ────────────────────────────────────────────────────────
    input                  = "${launchDir}/samplesheet_chicken.csv"
    outdir                 = "${launchDir}/results_chicken_assembly_free"
    mode                   = 'assembly_free'
    platform               = 'nanopore'

    // ── Preprocessing & Host Removal ──────────────────────────────────────────
    run_preprocessing      = false
    run_host_removal       = false

    // ── Taxonomic Profiling ───────────────────────────────────────────────────
    run_kraken2            = true
    kraken2_db             = "/home/koraop/nob_dir/metagenomics/metagenomics_pipe/databases/Standard/kraken2"
    kraken2_confidence     = 0.0

    // ── Bracken Abundance Re-estimation ───────────────────────────────────────
    run_bracken            = true
    bracken_threshold      = 10
    bracken_level          = 'S'

    // ── Visualization & Tables ────────────────────────────────────────────────
    run_krona              = true
    run_kraken_biom        = true
    run_multiqc            = true
}

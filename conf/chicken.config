/*
 * conf/chicken.config — Configuration for Chicken Nanopore Metagenomics Dataset
 * Layer: Infrastructure Layer
 *
 * Tailored for Oxford Nanopore chicken metagenomics reads (24 barcodes).
 * Default mode: assembly_free (Kraken2 + Bracken + Krona + BIOM) matching ONT wf-metagenomics.
 */

params {
    // ── Input & Output ────────────────────────────────────────────────────────
    input                  = "${launchDir}/samplesheet_chicken.csv"
    outdir                 = "${launchDir}/results_chicken"
    mode                   = 'assembly_free'   // 'assembly_free' หรือ 'assembly'
    platform               = 'nanopore'

    // ── Preprocessing & Filtering (Filtlong) ──────────────────────────────────
    run_preprocessing      = false             // ตั้งเป็น true หากต้องการกรองคุณภาพ reads ซ้ำ
    min_quality_long       = 10
    min_length_long        = 300
    run_filtlong           = false

    // ── Host Removal (Chicken Reference Genome GRCg7b) ─────────────────────────
    run_host_removal       = false             // ตั้งเป็น true หากต้องการตัดจีโนมไก่ออก
    host_genome            = "/home/koraop/nob_dir/metagenomics/metagenomics_pipe/databases/GRCg7b_GCF/GCF_016699485.2_bGalGal1.mat.broiler.GRCg7b_genomic.fna"

    // ── Taxonomic & Abundance Profiling (Kraken2 & Bracken) ───────────────────
    run_kraken2            = true
    kraken2_db             = "/home/koraop/nob_dir/metagenomics/metagenomics_pipe/databases/Standard/kraken2"
    kraken2_confidence     = 0.0
    save_kraken_output     = false

    run_bracken            = true
    bracken_threshold      = 10
    bracken_level          = 'S'
    bracken_read_len       = 1000

    run_krona              = true
    run_kraken_biom        = true
    run_humann3            = false

    // ── De Novo Assembly & MAG Recovery (สำหรับโหมด assembly) ─────────────────
    run_assembly           = true
    assembler              = 'flye'
    flye_mode              = '--nano-hq'
    flye_extra_args        = '--meta --min-overlap 1000'
    run_polishing          = false
    run_quast              = true

    min_contig_len_binning = 1000
    run_metabat2           = true
    run_maxbin2            = false
    run_semibin2           = false
    run_concoct            = false
    run_dastool            = false
    run_checkm2            = false
    run_gunc               = false
    run_gtdbtk             = false

    // ── Annotation & Reports ──────────────────────────────────────────────────
    run_prokka             = false
    run_genomad            = false
    run_multiqc            = true
    run_custom_report      = true

    // ── Resource Limits ───────────────────────────────────────────────────────
    max_cpus               = 16
    max_memory             = '64.GB'
    max_time               = '24.h'
}

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        enabled: true
    ]
}

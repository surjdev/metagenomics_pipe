# ==============================================================================
# .gitignore — Hybrid Metagenomics Nextflow DSL2 Pipeline
# ==============================================================================

# === Nextflow Runtime & Working Directories ===
.nextflow/
.nextflow.*
work/
results/
pipeline_info/
.checkpoints/

# === Container Caches & Images ===
*.sif
*.img
singularity_cache/

# === Large Reference Databases ===
databases/*
!databases/README.md
!databases/download.sh

# === Python & Environment Files ===
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/
ENV/
pyvenv.cfg
.pixi/

# === OS & Editor Artifacts ===
.DS_Store
Thumbs.db
.vscode/
.idea/
.gemini/
*.swp
*~

# === General Large Sequencing & Database Data ===
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.fasta
*.fa
*.fna
*.faa
*.bam
*.bai
*.sam
*.paf
*.bt2
*.dmnd
*.k2d

# === Explicit Whitelist for Synthetic Test Data & Manifests ===
# (Allows out-of-the-box CI/CD and test profile execution)
!test/data/**
!samples.csv